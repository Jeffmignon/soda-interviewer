# Copy to .env.local for development. Never commit real secrets.

# Postgres (production / docker). If unset, local SQLite at ./data/dev.db is used.
# DATABASE_URL="postgres://soda:soda@localhost:5432/soda"

# SQLite fallback for local/dev without Docker:
DATABASE_URL="file:./data/dev.db"

ADMIN_PASSWORD="change-me"

# Public origin used in copied outreach links (seed script). The admin UI uses the browser origin.
APP_URL="http://localhost:3000"

# AI: Vercel AI SDK. Gateway is the default provider when you pass a model string.
# On Vercel, AI Gateway can also authenticate via OIDC (no key in env).
# AI_GATEWAY_API_KEY=""

# Direct OpenAI (used when OPENAI_API_KEY is set and AI_GATEWAY_API_KEY is not)
# OPENAI_API_KEY=""

# Default model. Gateway-style ids work with AI Gateway; the openai/ prefix is stripped for direct OpenAI.
AI_MODEL="openai/gpt-4o"

# Optional extra signing material for the admin cookie (defaults to a fixed prefix + ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=""
